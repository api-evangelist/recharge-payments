                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Update a product"
        },
        {
          "info": {
            "name": "Delete a product",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.rechargeapps.com/products/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Delete a product"
        }
      ]
    }
  ],
  "bundled": true
}