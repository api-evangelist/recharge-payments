{
  "opencollection": "1.0.0",
  "info": {
    "name": "Recharge Addresses Products API",
    "version": "2021-11"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Recharge-Access-Token",
      "value": "{{X-Recharge-Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rechargeapps.com/products",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of results per page (default 50, max 250)."
              },
              {
                "name": "page_info",
                "value": "",
                "type": "query",
                "description": "Cursor for cursor-based pagination, taken from the Link response header."
              }
            ]
          },
          "docs": "List products"
        },
        {
          "info": {
            "name": "Create a product",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rechargeapps.com/products"
          },
          "docs": "Create a product"
        },
        {
          "info": {
            "name": "Retrieve a product",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rechargeapps.com/products/:id",
            "params": [
              {
                "name": "id",
                "value": "",
